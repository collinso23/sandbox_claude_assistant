      "IsPublic": true,
      "IsAbstract": true,
      "Documentation": {
        "Summary": "Base class for all components in s&box. Attach to a GameObject to add behavior.",
        "Remarks": "Components are created and destroyed automatically by the engine. Do not use new() — use GameObject.Components.Create<T>() instead."
      },
      "Methods": [
        {
          "Name": "OnStart",
          "ReturnType": "void",
          "IsPublic": false,
          "IsVirtual": true,
          "IsStatic": false,
          "Parameters": [],
