    {
      "Name": "NetworkMode",
      "FullName": "Sandbox.NetworkMode",
      "Namespace": "Sandbox",
      "Group": "enum",
      "Assembly": "sandbox",
      "IsPublic": true,
      "Documentation": {
        "Summary": "Determines how a networked value is replicated across connections."
      },
      "Fields": [
        {
          "Name": "None",
          "FieldType": "Sandbox.NetworkMode",
          "IsPublic": true,
          "IsStatic": true,
          "Value": "0",
          "Documentation": { "Summary": "No network replication." }
        },
        {
          "Name": "Broadcast",
          "FieldType": "Sandbox.NetworkMode",
          "IsPublic": true,
          "IsStatic": true,
          "Value": "1",
          "Documentation": { "Summary": "Replicate from host to all clients." }
        },
        {
          "Name": "FromOwner",
          "FieldType": "Sandbox.NetworkMode",
          "IsPublic": true,
          "IsStatic": true,
          "Value": "2",
          "Documentation": { "Summary": "Replicate from the owning connection to all others." }
        }
      ],
      "DocId": "T:Sandbox.NetworkMode"
    },

