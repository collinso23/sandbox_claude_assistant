          "DocId": "M:Sandbox.Component.OnStart"
        },
        {
          "Name": "OnUpdate",
          "ReturnType": "void",
          "IsPublic": false,
          "IsVirtual": true,
          "IsStatic": false,
          "Parameters": [],
          "Documentation": { "Summary": "Called every frame while this component is active." },
          "DocId": "M:Sandbox.Component.OnUpdate"
        },
        {
          "Name": "OnDestroy",
          "ReturnType": "void",
          "IsPublic": false,
          "IsVirtual": true,
          "IsStatic": false,
          "Parameters": [],
          "Documentation": { "Summary": "Called when this component is destroyed." },
          "DocId": "M:Sandbox.Component.OnDestroy"
        },
        {
          "Name": "Destroy",
          "ReturnType": "void",
          "IsPublic": true,
          "IsVirtual": false,
          "IsStatic": false,
          "Parameters": [],
          "Documentation": { "Summary": "Destroys this component and removes it from the GameObject." },
          "DocId": "M:Sandbox.Component.Destroy"
        }
      ],
