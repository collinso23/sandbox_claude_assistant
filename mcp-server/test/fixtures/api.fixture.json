          "IsPublic": true,
          "IsStatic": false,
          "GetAccess": "Public",
          "SetAccess": "Public",
          "Documentation": { "Summary": "Whether this component is active. When false, lifecycle methods are not called." },
          "DocId": "P:Sandbox.Component.Enabled"
